var sum = 0;
var i = 0;
while (i < 20000) {
  sum = sum + i * i - i / 4;
  i = i + 1;
}
print sum;

fun gcd(a, b) {
  while (a != b) {
    if (a > b) a = a - b; else b = b - a;
  }
  return a;
}

fun root(x) {
  var guess = x / 2;
  for (var k = 0; k < 20; k = k + 1) guess = (guess + x / guess) / 2;
  return guess;
}

var g = 0;
var r = 0;
for (var k = 1; k < 300; k = k + 1) {
  g = g + gcd(k * 6, 84);
  r = r + root(k);
}
print g;
print r > 3400 and r < 3500;
print -(1 / 3) * 3 == -1;

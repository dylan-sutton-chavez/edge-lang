var slugify = import("slugify_mod");

var s = slugify.Slugger();
s.add("Hello World");
s.add("From Rust");

print s.build();
// `hello-world-from-rust`
print s.shout();
// `HELLO-WORLD-FROM-RUST!`
print s.total_len();
// `18`
print s.repeat(2);
// `hello-world-from-rusthello-world-from-rust`

// pop mutates the state and returns the last part or nil
print s.pop();
// `rust`
print s.pop();
// `from`
print s.build();
// `hello-world`

// an error raised inside the module ends the run in the runtime's words
print s.repeat(-1);

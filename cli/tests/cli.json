      "edge.json": "{ \"imports\": { \"strict\": \"./strict/main.mini\" }, \"permissions\": { \"main\": [\"net:127.0.0.1\"], \"strict\": [\"net\"] } }\n",
      "strict/edge.json": "{}\n",
      "strict/main.mini": "import net\n\nfn reach():\n    return net.request('GET', 'http://127.0.0.1:9/')\n",
      "main.mini": "from strict import reach\nreach()\n"
    },
    "run": ["run", "--manifest", "edge.json", "main.mini"],
    "fails": ["'strict' has no net:127.0.0.1, edge.json grants it nothing"]
  },
  {
    "given": {
      "edge.json": "{ \"imports\": { \"strict\": \"./strict/main.mini\" } }\n",
      "strict/edge.json": "{ \"imports\": { \"helper\": \"./helper.mini\" } }\n",
      "strict/helper.mini": "fn shout(word):\n    return word.upper()\n",
      "strict/main.mini": "from helper import shout\n\nfn hello():\n    return shout('nested')\n",
      "main.mini": "from strict import hello\nprint(hello())\n"
    },
    "run": ["run", "--manifest", "edge.json", "main.mini"],
    "stdout": ["NESTED\n"]
  },
  {
    "given": {
      "edge.json": "{ \"imports\": { \"util\": \"./util/main.mini\" }, \"permissions\": { \"main\": [] } }\n",
      "util/edge.json": "{}\n",
      "util/main.mini": "fn write():\n    send('file:report.txt', 'from util')\n",
      "main.mini": "import util\nsend('file:mine.txt', 'from main')\ntry:\n    util.write()\nexcept PermissionError as e:\n    print(e)\n"
    },
    "run": ["run", "main.mini"],
    "stdout": ["'util' has no grant that reaches file:report.txt, only the root package writes a file channel without one\n"],
    "contains": {"mine.txt": "from main\n"}
  },
  {
    "given": {
      "edge.json": "{ \"imports\": { \"util\": \"./util/main.mini\" }, \"permissions\": { \"util\": [\"files:out/\"] } }\n",
      "util/edge.json": "{}\n",
      "util/out/kept.txt": "",
      "util/main.mini": "fn write():\n    send('file:util/out/report.txt', 'granted')\n",
      "main.mini": "import util\nutil.write()\n"
    },
    "run": ["run", "main.mini"],
    "contains": {"util/out/report.txt": "granted\n"}
  },
  {
    "given": {
      "main.mini": "send('report', 'row 1')\nprint('P1')\nsend('report', 'row 2')\nprint('P2')\n"
    },
    "run": ["run", "main.mini"],
    "stdout": ["report\nrow 1\nP1\nreport\nrow 2\nP2\n"]
  },
  {
    "given": {
      "edge.json": "{ \"imports\": { \"x\": \"./x.mini\" } }\n"
    },
    "run": ["init"],
    "fails": ["'./edge.json' already exists, init writes only into a directory without it"],
    "contains": {"edge.json": "\"x\": \"./x.mini\""}
  },
  {
    "given": {
      "edge.json": "{ \"imports\": { \"util\": \"./util/main.mini\" }, \"permissions\": { \"util\": [\"net\"] } }\n",
      "util/main.mini": "x = 1\n",
      "main.mini": "import util\nprint(util.x)\n"
    },
    "run": ["run", "main.mini"],
    "fails": ["permissions for 'util' reach nothing, its import './util/main.mini' has no edge.json of its own so it runs as part of this package"]
  },
  {
    "given": {
      "sub/edge.json": "{ \"imports\": { \"pkg\": \"./pkg/main.mini\" } }\n",
      "sub/pkg/edge.json": "{ \"permissions\": { \"all\": [\"net:a.test\"] } }\n",
      "sub/pkg/main.mini": "x = 1\n",
      "sub/main.mini": "import pkg\nprint(pkg.x)\n"
    },
    "run": ["run", "sub/main.mini"],
    "fails": ["edge.json does not grant what these packages ask for\n  pkg   net:a.test"]
  },
  {
    "run": ["init", "myapp", "--bare"],
    "stdout": ["created myapp/", "cd myapp && edge run main.mini"],
    "creates": ["myapp/main.mini", "myapp/edge.json"]
  }
]
